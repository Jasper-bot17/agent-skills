diff --git a/tests/test_order_service.py b/tests/test_order_service.py
index ccc3333..ddd4444 100644
--- a/tests/test_order_service.py
+++ b/tests/test_order_service.py
@@ -88,6 +88,22 @@ def test_calculate_total_with_discount():
     result = service.calculate_total(items)
     assert result == 90.00

+
+def test_calculate_total_precision():
+    """测试浮点数精度问题：0.1 + 0.2 应等于 0.30"""
+    service = OrderService()
+    items = [
+        MockItem(price=0.1, quantity=1, discount=0),
+        MockItem(price=0.2, quantity=1, discount=0),
+    ]
+    result = service.calculate_total(items)
+    assert result == 0.30
+
+
+def test_calculate_total_large_numbers():
+    """测试大额订单精度"""
+    service = OrderService()
+    items = [MockItem(price=99999.99, quantity=100, discount=0)]
+    result = service.calculate_total(items)
+    assert result == 9999999.00
