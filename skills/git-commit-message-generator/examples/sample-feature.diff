+"""微信扫码登录认证服务"""
+import requests
+from flask import current_app
+
+
+class WeChatAuthService:
+    """处理微信 OAuth 扫码登录流程"""
+
+    def __init__(self):
+        self.app_id = current_app.config['WECHAT_APP_ID']
+        self.app_secret = current_app.config['WECHAT_APP_SECRET']
+        self.base_url = 'https://api.weixin.qq.com/sns'
+
+    def get_qrcode_url(self, state: str) -> str:
+        """生成微信扫码登录二维码 URL"""
+        params = {
+            'appid': self.app_id,
+            'redirect_uri': current_app.config['WECHAT_REDIRECT_URI'],
+            'response_type': 'code',
+            'scope': 'snsapi_login',
+            'state': state,
+        }
+        return f"https://open.weixin.qq.com/connect/qrconnect?{'&'.join(f'{k}={v}' for k, v in params.items())}#wechat_redirect"
+
+    def get_access_token(self, code: str) -> dict:
+        """通过授权码获取 access_token 和 openid"""
+        url = f"{self.base_url}/oauth2/access_token"
+        params = {
+            'appid': self.app_id,
+            'secret': self.app_secret,
+            'code': code,
+            'grant_type': 'authorization_code',
+        }
+        resp = requests.get(url, params=params, timeout=10)
+        resp.raise_for_status()
+        return resp.json()
+
+    def get_user_info(self, access_token: str, openid: str) -> dict:
+        """获取微信用户基本信息"""
+        url = f"{self.base_url}/userinfo"
+        params = {
+            'access_token': access_token,
+            'openid': openid,
+        }
+        resp = requests.get(url, params=params, timeout=10)
+        resp.raise_for_status()
+        return resp.json()
+
+    def login_or_register(self, code: str) -> dict:
+        """微信登录：已有账号则登录，无则注册"""
+        token_data = self.get_access_token(code)
+        openid = token_data['openid']
+
+        # 查找已有用户
+        user = User.query.filter_by(wechat_openid=openid).first()
+        if user:
+            return {'user': user, 'is_new': False}
+
+        # 新用户：获取信息并注册
+        user_info = self.get_user_info(token_data['access_token'], openid)
+        user = User(
+            nickname=user_info.get('nickname'),
+            avatar=user_info.get('headimgurl'),
+            wechat_openid=openid,
+        )
+        db.session.add(user)
+        db.session.commit()
+        return {'user': user, 'is_new': True}
